# Jupiter API (token price, search and Ultra swap tools)
# Get a key at https://portal.jup.ag
JUPITER_API_KEY=

# LLM providers (agents use gpt-4.x / gpt-4o-mini)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WORKSPACE_DIR="agent_workspace"

# Qwen2.5-1.5B Instruct (OpenCode v2 compatible)
# Set QWEN_API_KEY to use Qwen instead of OpenAI models.
# Leave unset to use the default OpenAI-backed swarms agents.
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/api/v1
QWEN_MODEL=qwen2.5-1.5b-instruct
QWEN_TIMEOUT=30
QWEN_MAX_TOKENS=4096
QWEN_TEMPERATURE=0.7

# News research (Exa) — used by the sentiment agent
EXA_API_KEY=

# Stock fundamentals / OHLC (Massive API)
MASSIVE_API_KEY=

# Trading (Solana): base58-encoded private key used to sign Jupiter swaps.
# WALLET_PRIVATE_KEY is accepted as a backwards-compatible alias.
SOLANA_PRIVATE_KEY=""
