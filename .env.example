# Jupiter API (token price & search tools)
# Get a key at https://portal.jup.ag
JUPITER_API_KEY=

# OpenAI (experimental agents)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WORKSPACE_DIR="agent_workspace"

# Optional local research backend (default: litellm)
# Codex uses your existing `codex login`; no OpenAI API key is required.
# It uses supplied data only: no live search, handoffs, or order execution.
AUTOHEDGE_LLM_BACKEND=litellm
# Leave empty to use the CLI's default model.
AUTOHEDGE_CODEX_MODEL=
# Timeout per research stage; each task runs six stages.
AUTOHEDGE_CODEX_TIMEOUT=180


# Trading
WALLET_PRIVATE_KEY=""
